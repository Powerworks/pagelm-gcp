{
  "name": "pagelm",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p backend/tsconfig.json",
    "start": "node backend/dist/src/core/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "authors": [
    "nullure (https://github.com/nullure)",
    "recabasic (https://github.com/recabasic)"
  ],
  "engines": {
    "node": ">=21.18.0"
  },
  "dependencies": {
    "@google-cloud/speech": "^8.1.0",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@keyv/sqlite": "^4.0.5",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/classic": "^1.0.48",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.13",
    "@langchain/textsplitters": "^1.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@speech-sdk/core": "^0.29.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "d3-force": "^3.0.0",
    "docxtemplater": "^3.70.0",
    "keyv": "^5.6.0",
    "langchain": "^1.5.11",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "node-edge-tts": "^1.2.10",
    "openai": "^7.15.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0",
    "ws": "^8.21.3",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "expr-eval": "npm:expr-eval-fork@^3.0.0",
    "fast-xml-parser": "^5.4.1",
    "node-gyp": "^11.2.0",
    "tar": "^7.5.16",
    "make-fetch-happen": "^15.0.6",
    "cacache": "^21.0.1",
    "@tootallnate/once": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
